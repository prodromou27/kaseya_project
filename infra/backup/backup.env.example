# /etc/okp/backup.env (root:root 0600). Read by infra/backup/backup.sh / okp-backup.service. No secrets here:
# the encryption key is a PUBLIC key in GNUPGHOME; the private key is held offline by the key custodians.

APP_DIR=/opt/okp
BACKUP_DIR=/var/backups/okp
RETENTION_DAYS=14

# Full fingerprint of the backup encryption PUBLIC key imported into GNUPGHOME (never a short key ID).
GPG_RECIPIENT=
GNUPGHOME=/etc/okp/gnupg

# Off-host copy (required by default; the run exits 2 when it is missing or fails).
# Example: an rsync-over-SSH target reachable only by this host's dedicated backup key.
OFFHOST_TARGET=backup@backup-host.example.internal:/srv/okp-backups/
OFFHOST_CMD="rsync -a --chmod=F0600 -e 'ssh -i /etc/okp/backup_ssh_key -o BatchMode=yes'"
REQUIRE_OFFHOST=1
