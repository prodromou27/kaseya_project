# Development reverse proxy: single origin for the SPA (Vite dev server) and the API.
# Only this container publishes a port, bound to 127.0.0.1 in compose.dev.yml.
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
    listen 8080;
    server_name _;
    client_max_body_size 1m;
    server_tokens off;

    location = /healthz { access_log off; return 200 "ok\n"; }

    # VSA2-01 expected-inventory uploads only: Django enforces the 5 MB limit and validates content.
    location ~ ^/api/v1/customers/[0-9a-f-]+/onboarding/uploads/$ {
        client_max_body_size 6m;
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location /api/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location / {
        proxy_pass http://frontend:5173;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
