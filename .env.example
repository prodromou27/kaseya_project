# Development environment for compose.dev.yml. Copy to .env and change every value.
# NEVER commit .env. NEVER put vendor API credentials here — connectors are fixture-only until P1 approval.

POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=change-me-dev-only

DJANGO_SECRET_KEY=change-me-to-a-long-random-dev-value
LOCAL_LOGIN_ENABLED=true

# Used by `manage.py bootstrap_admin` (one-time) and `manage.py seed_demo`. Min 14 chars.
BOOTSTRAP_ADMIN_PASSWORD=
DEMO_USER_PASSWORD=

# OIDC (Microsoft Entra ID). Leave disabled in dev unless testing against an approved test tenant.
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8080/api/v1/auth/oidc/callback/

# Connector egress allowlist (comma-separated hostnames). Empty = no live VSA host permitted.
CONNECTOR_ALLOWED_HOSTS_VSA_X=
CONNECTOR_APPROVED_PRIVATE_CIDRS=
