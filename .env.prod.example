# Production environment for compose.prod.yml on the AlmaLinux host. Copy to .env.prod (chmod 600, never commit).
#   docker compose -f compose.prod.yml --env-file .env.prod up -d
# Secrets are NOT set here: they are files under ./secrets (see infra/almalinux/prepare-secrets.sh).

# Image tag built/pulled for this release.
OKP_VERSION=local

# Public DNS name of the portal (must match the TLS certificate). Used for ALLOWED_HOSTS, CSRF and OIDC redirect.
PORTAL_HOSTNAME=portal.example.internal
# Extra names/IPs users may open the portal with (comma-separated). install.sh adds this server's IPv4 addresses.
PORTAL_EXTRA_HOSTS=
# Host address the proxy publishes 80/443 on. Use the service IP, not 0.0.0.0, when the host has several interfaces.
PORTAL_BIND_ADDRESS=0.0.0.0

POSTGRES_DB=portal
POSTGRES_USER=portal

# Sign-in. Production should use OIDC (Microsoft Entra ID); local login only for break-glass if approved.
LOCAL_LOGIN_ENABLED=false
OIDC_ENABLED=true
OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=<client-id>
OIDC_AUTO_PROVISION=true

# Connector egress allowlist: exact VSA X server hostname(s), comma-separated. Empty = no live VSA host permitted.
CONNECTOR_ALLOWED_HOSTS_VSA_X=
CONNECTOR_APPROVED_PRIVATE_CIDRS=

# VSA5-EXEC: emergency stop for executing approved group moves in VSA X. Moves are switched on per integration in
# the portal (Settings -> Integrations -> Edit); false blocks them on the whole server. Uses the integration's API token; optional separate write token VSA_WRITE_<NAME> (or _FILE).
VSA_GROUP_MOVE_EXECUTION_ENABLED=true
# CFA (ADR-031): assigning VSA X custom fields to workstations. Set up in the portal by a super admin (Settings ->
# Integrations -> Edit: write token, test-workstation validation, switch); nothing is written before that.
# This is only an emergency stop: false blocks every custom field write on this server.
VSA_CUSTOM_FIELD_WRITES_ENABLED=true
# An optional separate write token can be entered in the portal (encrypted). Alternative: put TOKEN_ID:TOKEN_SECRET in
# ./secrets/vsa_write_token (mode 0640, created empty by prepare-secrets.sh) and reference it as env:VSA_WRITE_TOKEN.
# CAT-02: daily read of the public VSA 10 Application Catalog page (outbound HTTPS to help.vsa10.kaseya.com).
# Higher versions for already-approved products apply automatically; the rest waits for approval.
VSA_APP_CATALOG_AUTO_UPDATE=true
